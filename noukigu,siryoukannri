<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>農場資材在庫管理アプリ</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans JP', sans-serif;
            background-color: #f3f4f6;
        }
        .animate-fade-in {
            animation: fadeIn 0.2s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="min-h-screen text-gray-800 pb-12">

    <!-- Header / Navbar -->
    <header class="bg-emerald-700 text-white shadow-md sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-wheat-awn text-emerald-300 text-2xl"></i>
                <h1 class="font-bold text-xl tracking-wide">アグリ在庫管理</h1>
                <span id="demoBadge" class="hidden text-xs bg-emerald-800 text-emerald-200 px-2 py-0.5 rounded-full border border-emerald-600">デモモード</span>
            </div>

            <!-- User Status / Auth Button -->
            <div id="authContainer" class="flex items-center space-x-3">
                <!-- Logged In View -->
                <div id="userInfo" class="hidden flex items-center space-x-3">
                    <img id="userAvatar" class="w-8 h-8 rounded-full border border-emerald-400" src="" alt="User Avatar">
                    <span id="userName" class="text-sm font-medium hidden sm:inline">ユーザー</span>
                    <button id="logoutBtn" class="text-xs bg-emerald-800 hover:bg-emerald-900 text-white px-3 py-1.5 rounded-lg border border-emerald-600 transition flex items-center space-x-1">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span class="hidden sm:inline">ログアウト</span>
                    </button>
                </div>
                <!-- Logged Out View -->
                <button id="loginBtn" class="bg-amber-500 hover:bg-amber-600 text-white text-sm px-3.5 py-1.5 rounded-lg font-medium shadow-sm transition flex items-center space-x-1.5">
                    <i class="fa-brands fa-google"></i>
                    <span>Googleでログイン</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">

        <!-- Top Actions & Stats Row -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <!-- Stat Card 1 -->
            <div class="bg-white p-4 rounded-xl shadow-sm border border-emerald-100 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-gray-500">登録アイテム数</p>
                    <p id="statTotalItems" class="text-2xl font-bold text-gray-800">0</p>
                </div>
                <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-lg flex items-center justify-center text-xl">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>
            </div>

            <!-- Stat Card 2 -->
            <div class="bg-white p-4 rounded-xl shadow-sm border border-amber-100 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-gray-500">要補充（発注目安割れ）</p>
                    <p id="statLowStock" class="text-2xl font-bold text-amber-600">0</p>
                </div>
                <div class="w-10 h-10 bg-amber-50 text-amber-600 rounded-lg flex items-center justify-center text-xl">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
            </div>

            <!-- Add Item Action Button (Spans 2 columns on desktop) -->
            <div class="md:col-span-2 bg-gradient-to-r from-emerald-600 to-teal-600 rounded-xl p-4 shadow-sm text-white flex items-center justify-between">
                <div>
                    <h2 class="font-bold text-lg">資材の追加登録</h2>
                    <p class="text-xs text-emerald-100">肥料・農薬・種子などの新しい在庫を追加</p>
                </div>
                <button id="openAddModalBtn" class="bg-white text-emerald-700 hover:bg-emerald-50 font-bold px-4 py-2 rounded-lg text-sm shadow transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-plus"></i>
                    <span>新規資材を追加</span>
                </button>
            </div>
        </div>

        <!-- Filter & Search Controls -->
        <div class="bg-white p-4 rounded-xl shadow-sm mb-6 border border-gray-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
            
            <!-- Category Tabs -->
            <div class="flex items-center space-x-1 overflow-x-auto pb-2 md:pb-0 scrollbar-none" id="categoryFilter">
                <button data-cat="all" class="cat-btn active bg-emerald-700 text-white px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition">
                    すべて
                </button>
                <button data-cat="肥料" class="cat-btn bg-gray-100 text-gray-600 hover:bg-gray-200 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition">
                    🧪 肥料
                </button>
                <button data-cat="農薬" class="cat-btn bg-gray-100 text-gray-600 hover:bg-gray-200 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition">
                    🛡️ 農薬
                </button>
                <button data-cat="種子" class="cat-btn bg-gray-100 text-gray-600 hover:bg-gray-200 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition">
                    🌱 種苗・種子
                </button>
                <button data-cat="マルチ・資材" class="cat-btn bg-gray-100 text-gray-600 hover:bg-gray-200 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition">
                    📜 マルチ・資材
                </button>
                <button data-cat="その他" class="cat-btn bg-gray-100 text-gray-600 hover:bg-gray-200 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition">
                    📦 その他
                </button>
            </div>

            <!-- Search and Stock Filter -->
            <div class="flex items-center space-x-2 w-full md:w-auto">
                <div class="relative flex-1 md:w-64">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-gray-400 text-sm"></i>
                    <input type="text" id="searchInput" placeholder="資材名・保管場所で検索..." class="w-full pl-9 pr-3 py-1.5 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition">
                </div>
                <label class="flex items-center space-x-1.5 text-xs text-gray-600 cursor-pointer whitespace-nowrap bg-gray-50 border border-gray-200 px-2.5 py-2 rounded-lg hover:bg-gray-100">
                    <input type="checkbox" id="lowStockOnly" class="rounded text-emerald-600 focus:ring-emerald-500">
                    <span>要補充のみ</span>
                </label>
            </div>
        </div>

        <!-- Prominent Google Auth Banner (Shows when not logged in with active Firebase) -->
        <div id="authPromptBanner" class="hidden bg-gradient-to-r from-emerald-800 to-teal-800 text-white rounded-2xl p-6 sm:p-8 mb-6 shadow-md text-center animate-fade-in">
            <div class="max-w-md mx-auto space-y-4">
                <div class="w-12 h-12 bg-white/10 rounded-full flex items-center justify-center mx-auto text-2xl text-emerald-300">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
                <h2 class="text-xl sm:text-2xl font-bold">クラウド同期でデータを安全に保存</h2>
                <p class="text-xs sm:text-sm text-emerald-100">
                    Googleアカウントでログインすると、スマホ・タブレット・PCなど複数の端末で農場の在庫情報をリアルタイムに共有・同期できます。
                </p>
                <button id="bannerLoginBtn" class="bg-white hover:bg-emerald-50 text-gray-800 font-bold px-6 py-3 rounded-xl shadow-lg transition flex items-center justify-center space-x-3 w-full sm:w-auto mx-auto border border-gray-200">
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                    </svg>
                    <span>Googleアカウントでサインイン</span>
                </button>
            </div>
        </div>

        <!-- Inventory Items Grid -->
        <div id="itemList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <!-- Dynamic Content generated by JS -->
        </div>

        <!-- Empty State View -->
        <div id="emptyState" class="hidden text-center py-12 bg-white rounded-xl border border-dashed border-gray-300 my-4">
            <i class="fa-solid fa-boxes-packing text-4xl text-gray-300 mb-3"></i>
            <p class="text-gray-500 font-medium">該当する資材が見つかりません</p>
            <p class="text-xs text-gray-400 mt-1">「新規資材を追加」から登録するか、検索条件を変更してください。</p>
        </div>
    </main>

    <!-- Modal Form (Add / Edit Item) -->
    <div id="itemModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-lg w-full max-h-[90vh] overflow-y-auto animate-fade-in">
            <div class="p-5 border-b border-gray-100 flex justify-between items-center bg-emerald-50/50 rounded-t-2xl">
                <h3 id="modalTitle" class="font-bold text-lg text-emerald-900">新規資材の登録</h3>
                <button id="closeModalBtn" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <form id="itemForm" class="p-5 space-y-4">
                <input type="hidden" id="itemId">

                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">資材名 <span class="text-red-500">*</span></label>
                    <input type="text" id="itemName" required placeholder="例: 化成肥料 8-8-8" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">カテゴリ <span class="text-red-500">*</span></label>
                        <select id="itemCategory" required class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                            <option value="肥料">🧪 肥料</option>
                            <option value="農薬">🛡️ 農薬</option>
                            <option value="種子">🌱 種苗・種子</option>
                            <option value="マルチ・資材">📜 マルチ・資材</option>
                            <option value="その他">📦 その他</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">保管場所</label>
                        <input type="text" id="itemLocation" placeholder="例: A倉庫 棚2" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">現在庫数 <span class="text-red-500">*</span></label>
                        <input type="number" id="itemQuantity" step="0.1" required min="0" placeholder="10" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">単位 <span class="text-red-500">*</span></label>
                        <select id="itemUnit" required class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                            <option value="袋">袋</option>
                            <option value="kg">kg</option>
                            <option value="L">L</option>
                            <option value="本">本</option>
                            <option value="巻">巻</option>
                            <option value="個">個</option>
                            <option value="箱">箱</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1" title="在庫数がこの値を下回ると発注警報を表示します">発注目安 (通知)</label>
                        <input type="number" id="itemThreshold" step="0.1" min="0" placeholder="3" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">使用期限 / 有効期限</label>
                        <input type="date" id="itemExpiry" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">購入日</label>
                        <input type="date" id="itemPurchase" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-700 mb-1">メモ / 備考</label>
                    <textarea id="itemNotes" rows="2" placeholder="適用作物や希釈倍率、購入先など" class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
                </div>

                <div class="pt-3 flex justify-end space-x-2">
                    <button type="button" id="cancelModalBtn" class="px-4 py-2 text-sm text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg font-medium transition">キャンセル</button>
                    <button type="submit" class="px-5 py-2 text-sm text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg font-medium shadow transition">保存する</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast" class="fixed bottom-5 right-5 bg-gray-800 text-white text-sm px-4 py-3 rounded-xl shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 flex items-center space-x-2 z-50">
        <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400"></i>
        <span id="toastMsg">通知メッセージ</span>
    </div>

    <!-- Firebase Modular SDK -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, addDoc, updateDoc, deleteDoc, onSnapshot, query } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Configuration Template
        // ※ GitHub Pages等にデプロイする際、自身のプロジェクト情報に置き換えてください
        const firebaseConfig = {
            apiKey: "YOUR_API_KEY",
            authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
            projectId: "YOUR_PROJECT_ID",
            storageBucket: "YOUR_PROJECT_ID.appspot.com",
            messagingSenderId: "YOUR_SENDER_ID",
            appId: "YOUR_APP_ID"
        };

        let auth = null;
        let db = null;
        let currentUser = null;
        let isFirebaseActive = false;

        // Application State
        let items = [];
        let activeCategory = 'all';
        let searchQuery = '';
        let lowStockOnly = false;

        // Initial Demo Sample Data
        const sampleItems = [
            { id: '1', name: '化成肥料 14-14-14', category: '肥料', quantity: 15, unit: '袋', threshold: 5, location: '第一倉庫', expiry: '', purchase: '2026-03-01', notes: '全般用オールマイティ' },
            { id: '2', name: 'スミチオン乳剤', category: '農薬', quantity: 2, unit: 'L', threshold: 3, location: '農薬保管庫', expiry: '2027-10-31', purchase: '2026-01-15', notes: '害虫防除用' },
            { id: '3', name: '黒マルチ 0.02mm×135cm', category: 'マルチ・資材', quantity: 1, unit: '巻', threshold: 2, location: '資材棚B', expiry: '', purchase: '', notes: '春植え野菜用' },
            { id: '4', name: '春まき大根 種子 (夏つかさ)', category: '種子', quantity: 8, unit: '袋', threshold: 2, location: '種子冷蔵庫', expiry: '2026-12-31', purchase: '2026-02-10', notes: '発芽率85%以上' }
        ];

        // Attempt Firebase Init
        try {
            if (firebaseConfig.apiKey !== "YOUR_API_KEY") {
                const app = initializeApp(firebaseConfig);
                auth = getAuth(app);
                db = getFirestore(app);
                isFirebaseActive = true;
            } else {
                console.log("Firebase API key is default placeholder. Running in Local Mode.");
                document.getElementById('demoBadge').classList.remove('hidden');
            }
        } catch (e) {
            console.warn("Firebase initialization failed, switching to Local Storage mode.", e);
            document.getElementById('demoBadge').classList.remove('hidden');
        }

        // DOM Elements
        const itemListEl = document.getElementById('itemList');
        const emptyStateEl = document.getElementById('emptyState');
        const itemModal = document.getElementById('itemModal');
        const itemForm = document.getElementById('itemForm');
        const searchInput = document.getElementById('searchInput');
        const lowStockCheckbox = document.getElementById('lowStockOnly');
        const loginBtn = document.getElementById('loginBtn');
        const bannerLoginBtn = document.getElementById('bannerLoginBtn');
        const authPromptBanner = document.getElementById('authPromptBanner');
        const logoutBtn = document.getElementById('logoutBtn');
        const userInfo = document.getElementById('userInfo');

        // --- AUTHENTICATION ---
        async function handleLogin() {
            if (!isFirebaseActive || !auth) {
                showToast('APIキー未設定のためデモモード動作中です', 'info');
                return;
            }
            try {
                const provider = new GoogleAuthProvider();
                await signInWithPopup(auth, provider);
                showToast('ログインしました', 'success');
            } catch (err) {
                console.error("Login failed:", err);
                showToast('ログインに失敗しました', 'error');
            }
        }

        loginBtn.addEventListener('click', handleLogin);
        if (bannerLoginBtn) bannerLoginBtn.addEventListener('click', handleLogin);

        if (isFirebaseActive && auth) {
            logoutBtn.addEventListener('click', async () => {
                try {
                    await signOut(auth);
                    showToast('ログアウトしました', 'info');
                } catch (err) {
                    console.error("Logout failed:", err);
                }
            });

            onAuthStateChanged(auth, (user) => {
                currentUser = user;
                if (user) {
                    document.getElementById('userAvatar').src = user.photoURL || 'https://via.placeholder.com/32';
                    document.getElementById('userName').textContent = user.displayName || user.email;
                    loginBtn.classList.add('hidden');
                    userInfo.classList.remove('hidden');
                    authPromptBanner.classList.add('hidden');
                    subscribeToFirestore();
                } else {
                    loginBtn.classList.remove('hidden');
                    userInfo.classList.add('hidden');
                    authPromptBanner.classList.remove('hidden');
                    loadLocalItems();
                }
            });
        } else {
            loadLocalItems();
        }

        // --- FIRESTORE / STORAGE LISTENERS ---
        function subscribeToFirestore() {
            if (!db || !currentUser) return;
            
            // Standard Firestore structure: artifacts/{appId}/users/{userId}/inventory
            const appId = typeof __app_id !== 'undefined' ? __app_id : 'farm-app';
            const userDocRef = collection(db, 'artifacts', appId, 'users', currentUser.uid, 'inventory');
            
            onSnapshot(userDocRef, (snapshot) => {
                items = [];
                snapshot.forEach((doc) => {
                    items.push({ id: doc.id, ...doc.data() });
                });
                renderUI();
            }, (error) => {
                console.error("Firestore sync error:", error);
                showToast('データ同期エラー', 'error');
            });
        }

        function loadLocalItems() {
            const saved = localStorage.getItem('farm_inventory_items');
            if (saved) {
                try {
                    items = JSON.parse(saved);
                } catch (e) {
                    items = [...sampleItems];
                }
            } else {
                items = [...sampleItems];
                saveLocalItems();
            }
            renderUI();
        }

        function saveLocalItems() {
            if (!isFirebaseActive || !currentUser) {
                localStorage.setItem('farm_inventory_items', JSON.stringify(items));
            }
        }

        // --- DATA MUTATIONS ---
        async function saveItem(data) {
            if (isFirebaseActive && currentUser && db) {
                const appId = typeof __app_id !== 'undefined' ? __app_id : 'farm-app';
                const colRef = collection(db, 'artifacts', appId, 'users', currentUser.uid, 'inventory');
                
                if (data.id) {
                    const docRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'inventory', data.id);
                    const { id, ...updateData } = data;
                    await updateDoc(docRef, updateData);
                } else {
                    await addDoc(colRef, data);
                }
            } else {
                // Local Mode
                if (data.id) {
                    const idx = items.findIndex(i => i.id === data.id);
                    if (idx !== -1) items[idx] = data;
                } else {
                    data.id = Date.now().toString();
                    items.push(data);
                }
                saveLocalItems();
                renderUI();
            }
        }

        async function updateQuantity(id, delta) {
            const item = items.find(i => i.id === id);
            if (!item) return;

            const newQty = Math.max(0, Math.round((parseFloat(item.quantity) + delta) * 100) / 100);

            if (isFirebaseActive && currentUser && db) {
                const appId = typeof __app_id !== 'undefined' ? __app_id : 'farm-app';
                const docRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'inventory', id);
                await updateDoc(docRef, { quantity: newQty });
            } else {
                item.quantity = newQty;
                saveLocalItems();
                renderUI();
            }
        }

        async function deleteItem(id) {
            if (!confirm('この資材情報を削除してもよろしいですか？')) return;

            if (isFirebaseActive && currentUser && db) {
                const appId = typeof __app_id !== 'undefined' ? __app_id : 'farm-app';
                const docRef = doc(db, 'artifacts', appId, 'users', currentUser.uid, 'inventory', id);
                await deleteDoc(docRef);
                showToast('削除しました', 'info');
            } else {
                items = items.filter(i => i.id !== id);
                saveLocalItems();
                renderUI();
                showToast('削除しました', 'info');
            }
        }

        // --- RENDER FUNCTIONS ---
        function renderUI() {
            // Filter Items
            const filtered = items.filter(item => {
                const matchesCategory = activeCategory === 'all' || item.category === activeCategory;
                const matchesSearch = item.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                      (item.location && item.location.toLowerCase().includes(searchQuery.toLowerCase()));
                const isLow = item.threshold && item.quantity <= item.threshold;
                const matchesLowStock = !lowStockOnly || isLow;

                return matchesCategory && matchesSearch && matchesLowStock;
            });

            // Update Header Stats
            document.getElementById('statTotalItems').textContent = items.length;
            const lowCount = items.filter(i => i.threshold && i.quantity <= i.threshold).length;
            document.getElementById('statLowStock').textContent = lowCount;

            // Render Cards
            itemListEl.innerHTML = '';
            if (filtered.length === 0) {
                emptyStateEl.classList.remove('hidden');
            } else {
                emptyStateEl.classList.add('hidden');
                filtered.forEach(item => {
                    itemListEl.appendChild(createItemCard(item));
                });
            }
        }

        function createItemCard(item) {
            const card = document.createElement('div');
            card.className = 'bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition flex flex-col justify-between';

            const isLow = item.threshold !== '' && item.threshold !== null && item.quantity <= item.threshold;
            
            // Category Badge Icons
            let catBadgeClass = 'bg-gray-100 text-gray-700';
            if (item.category === '肥料') catBadgeClass = 'bg-emerald-100 text-emerald-800';
            else if (item.category === '農薬') catBadgeClass = 'bg-amber-100 text-amber-800';
            else if (item.category === '種子') catBadgeClass = 'bg-green-100 text-green-800';
            else if (item.category === 'マルチ・資材') catBadgeClass = 'bg-blue-100 text-blue-800';

            card.innerHTML = `
                <div class="p-4">
                    <!-- Top Row: Badge & Actions -->
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs px-2.5 py-0.5 rounded-full font-medium ${catBadgeClass}">
                            ${item.category}
                        </span>
                        <div class="flex items-center space-x-1 text-gray-400">
                            <button class="edit-btn hover:text-emerald-600 p-1 transition" title="編集">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button class="delete-btn hover:text-red-500 p-1 transition" title="削除">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Item Title -->
                    <h3 class="font-bold text-gray-900 text-base mb-1 line-clamp-1">${escapeHtml(item.name)}</h3>

                    <!-- Meta info -->
                    <div class="text-xs text-gray-500 space-y-1 mb-4">
                        ${item.location ? `<div><i class="fa-solid fa-location-dot text-gray-400 mr-1"></i>${escapeHtml(item.location)}</div>` : ''}
                        ${item.expiry ? `<div><i class="fa-solid fa-calendar-xmark text-gray-400 mr-1"></i>期限: ${item.expiry}</div>` : ''}
                        ${item.notes ? `<div class="italic text-gray-400 line-clamp-1">${escapeHtml(item.notes)}</div>` : ''}
                    </div>

                    <!-- Quantity Control Block -->
                    <div class="bg-gray-50 rounded-xl p-3 flex items-center justify-between border border-gray-100">
                        <div>
                            <div class="text-xs text-gray-400 font-medium">現在庫数</div>
                            <div class="flex items-baseline space-x-1">
                                <span class="text-2xl font-black ${isLow ? 'text-red-500' : 'text-gray-800'}">${item.quantity}</span>
                                <span class="text-xs text-gray-500 font-medium">${escapeHtml(item.unit)}</span>
                            </div>
                        </div>

                        <!-- Incremental Controls -->
                        <div class="flex items-center space-x-1 bg-white rounded-lg p-1 border border-gray-200 shadow-sm">
                            <button class="minus-btn w-8 h-8 rounded-md bg-gray-50 hover:bg-emerald-50 text-gray-600 hover:text-emerald-600 font-bold flex items-center justify-center transition">
                                <i class="fa-solid fa-minus text-xs"></i>
                            </button>
                            <button class="plus-btn w-8 h-8 rounded-md bg-gray-50 hover:bg-emerald-50 text-gray-600 hover:text-emerald-600 font-bold flex items-center justify-center transition">
                                <i class="fa-solid fa-plus text-xs"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Low Stock Alert Banner -->
                ${isLow ? `
                    <div class="bg-amber-50 border-t border-amber-100 px-4 py-1.5 text-xs text-amber-700 font-medium flex items-center justify-between">
                        <span><i class="fa-solid fa-triangle-exclamation mr-1"></i>発注ライン以下 (目安: ${item.threshold}${item.unit})</span>
                    </div>
                ` : ''}
            `;

            // Card Event Listeners
            card.querySelector('.plus-btn').addEventListener('click', () => updateQuantity(item.id, 1));
            card.querySelector('.minus-btn').addEventListener('click', () => updateQuantity(item.id, -1));
            card.querySelector('.edit-btn').addEventListener('click', () => openModal(item));
            card.querySelector('.delete-btn').addEventListener('click', () => deleteItem(item.id));

            return card;
        }

        // --- MODAL CONTROLS ---
        function openModal(itemToEdit = null) {
            itemForm.reset();
            if (itemToEdit) {
                document.getElementById('modalTitle').textContent = '資材情報の編集';
                document.getElementById('itemId').value = itemToEdit.id;
                document.getElementById('itemName').value = itemToEdit.name;
                document.getElementById('itemCategory').value = itemToEdit.category;
                document.getElementById('itemLocation').value = itemToEdit.location || '';
                document.getElementById('itemQuantity').value = itemToEdit.quantity;
                document.getElementById('itemUnit').value = itemToEdit.unit;
                document.getElementById('itemThreshold').value = itemToEdit.threshold || '';
                document.getElementById('itemExpiry').value = itemToEdit.expiry || '';
                document.getElementById('itemPurchase').value = itemToEdit.purchase || '';
                document.getElementById('itemNotes').value = itemToEdit.notes || '';
            } else {
                document.getElementById('modalTitle').textContent = '新規資材の登録';
                document.getElementById('itemId').value = '';
            }
            itemModal.classList.remove('hidden');
            itemModal.classList.add('flex');
        }

        function closeModal() {
            itemModal.classList.add('hidden');
            itemModal.classList.remove('flex');
        }

        // Form Submit
        itemForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = {
                id: document.getElementById('itemId').value || null,
                name: document.getElementById('itemName').value,
                category: document.getElementById('itemCategory').value,
                location: document.getElementById('itemLocation').value,
                quantity: parseFloat(document.getElementById('itemQuantity').value) || 0,
                unit: document.getElementById('itemUnit').value,
                threshold: document.getElementById('itemThreshold').value ? parseFloat(document.getElementById('itemThreshold').value) : '',
                expiry: document.getElementById('itemExpiry').value,
                purchase: document.getElementById('itemPurchase').value,
                notes: document.getElementById('itemNotes').value
            };

            await saveItem(formData);
            closeModal();
            showToast('保存しました', 'success');
        });

        // Modal Open/Close Event Listeners
        document.getElementById('openAddModalBtn').addEventListener('click', () => openModal());
        document.getElementById('closeModalBtn').addEventListener('click', closeModal);
        document.getElementById('cancelModalBtn').addEventListener('click', closeModal);

        // Filter / Search Listeners
        document.querySelectorAll('.cat-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.cat-btn').forEach(b => {
                    b.classList.remove('bg-emerald-700', 'text-white');
                    b.classList.add('bg-gray-100', 'text-gray-600');
                });
                btn.classList.remove('bg-gray-100', 'text-gray-600');
                btn.classList.add('bg-emerald-700', 'text-white');
                activeCategory = btn.dataset.cat;
                renderUI();
            });
        });

        searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value;
            renderUI();
        });

        lowStockCheckbox.addEventListener('change', (e) => {
            lowStockOnly = e.target.checked;
            renderUI();
        });

        // --- UTILITY FUNCTIONS ---
        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toastMsg');
            const toastIcon = document.getElementById('toastIcon');

            toastMsg.textContent = msg;
            if (type === 'error') {
                toastIcon.className = 'fa-solid fa-circle-exclamation text-red-400';
            } else if (type === 'info') {
                toastIcon.className = 'fa-solid fa-circle-info text-blue-400';
            } else {
                toastIcon.className = 'fa-solid fa-circle-check text-emerald-400';
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>"']/g, function(m) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
            });
        }
    </script>
</body>
</html>
